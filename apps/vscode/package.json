{
  "name": "nokker-vscode",
  "displayName": "Nokker",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "nokker",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nokker-ai/nokker-apps.git",
    "directory": "apps/vscode"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "nokker",
    "lokkal",
    "agent",
    "local",
    "ai",
    "coding",
    "checkpoints",
    "approvals"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%untrusted%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nokker",
          "title": "Nokker",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "nokker": [
        {
          "type": "webview",
          "id": "nokker.chat",
          "name": "%view.chat%"
        },
        {
          "id": "nokker.changes",
          "name": "%view.changes%",
          "icon": "media/activity.svg"
        },
        {
          "id": "nokker.sessions",
          "name": "%view.sessions%",
          "icon": "media/activity.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "nokker.sendSelection",
        "title": "%cmd.sendSelection%",
        "category": "Nokker"
      },
      {
        "command": "nokker.addFile",
        "title": "%cmd.addFile%",
        "category": "Nokker",
        "icon": "$(mention)"
      },
      {
        "command": "nokker.addProblems",
        "title": "%cmd.addProblems%",
        "category": "Nokker"
      },
      {
        "command": "nokker.fixProblems",
        "title": "%cmd.fixProblems%",
        "category": "Nokker"
      },
      {
        "command": "nokker.addTerminalOutput",
        "title": "%cmd.addTerminalOutput%",
        "category": "Nokker"
      },
      {
        "command": "nokker.newThread",
        "title": "%cmd.newThread%",
        "category": "Nokker",
        "icon": "$(add)"
      },
      {
        "command": "nokker.cancel",
        "title": "%cmd.cancel%",
        "category": "Nokker",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nokker.reconnect",
        "title": "%cmd.reconnect%",
        "category": "Nokker",
        "icon": "$(refresh)"
      },
      {
        "command": "nokker.refreshSessions",
        "title": "%cmd.refreshSessions%",
        "category": "Nokker",
        "icon": "$(refresh)"
      },
      {
        "command": "nokker.openSession",
        "title": "%cmd.openSession%",
        "category": "Nokker"
      },
      {
        "command": "nokker.openLive",
        "title": "%cmd.openLive%",
        "category": "Nokker"
      },
      {
        "command": "nokker.review.openDiff",
        "title": "%cmd.reviewOpenDiff%",
        "category": "Nokker",
        "icon": "$(diff)"
      },
      {
        "command": "nokker.review.accept",
        "title": "%cmd.reviewAccept%",
        "category": "Nokker",
        "icon": "$(check)"
      },
      {
        "command": "nokker.review.refuse",
        "title": "%cmd.reviewRefuse%",
        "category": "Nokker",
        "icon": "$(discard)"
      },
      {
        "command": "nokker.review.acceptAll",
        "title": "%cmd.reviewAcceptAll%",
        "category": "Nokker",
        "icon": "$(check-all)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nokker.openSession",
          "when": "false"
        },
        {
          "command": "nokker.openLive",
          "when": "false"
        },
        {
          "command": "nokker.review.openDiff",
          "when": "false"
        },
        {
          "command": "nokker.review.accept",
          "when": "nokker.reviewFileOpen"
        },
        {
          "command": "nokker.review.refuse",
          "when": "nokker.reviewFileOpen"
        }
      ],
      "editor/context": [
        {
          "command": "nokker.sendSelection",
          "when": "editorHasSelection",
          "group": "nokker@1"
        },
        {
          "command": "nokker.addFile",
          "when": "resourceScheme == file",
          "group": "nokker@2"
        },
        {
          "command": "nokker.addProblems",
          "when": "resourceScheme == file",
          "group": "nokker@3"
        }
      ],
      "explorer/context": [
        {
          "command": "nokker.addFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "nokker@1"
        }
      ],
      "terminal/context": [
        {
          "command": "nokker.addTerminalOutput",
          "group": "nokker@1"
        }
      ],
      "editor/title": [
        {
          "command": "nokker.review.accept",
          "when": "nokker.reviewFileOpen",
          "group": "navigation@1"
        },
        {
          "command": "nokker.review.refuse",
          "when": "nokker.reviewFileOpen",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "nokker.newThread",
          "when": "view == nokker.chat",
          "group": "navigation@1"
        },
        {
          "command": "nokker.reconnect",
          "when": "view == nokker.chat",
          "group": "navigation@2"
        },
        {
          "command": "nokker.review.acceptAll",
          "when": "view == nokker.changes",
          "group": "navigation@1"
        },
        {
          "command": "nokker.newThread",
          "when": "view == nokker.sessions",
          "group": "navigation@1"
        },
        {
          "command": "nokker.refreshSessions",
          "when": "view == nokker.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "nokker.review.accept",
          "when": "view == nokker.changes && viewItem == nokker.change.open",
          "group": "inline@1"
        },
        {
          "command": "nokker.review.refuse",
          "when": "view == nokker.changes && viewItem == nokker.change.open",
          "group": "inline@2"
        },
        {
          "command": "nokker.review.openDiff",
          "when": "view == nokker.changes",
          "group": "inline@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nokker.sendSelection",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Nokker",
      "properties": {
        "nokker.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.serverUrl%"
        },
        "nokker.liveWrite.openEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.liveWrite%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "nokker.changes",
        "contents": "%welcome.changes%"
      },
      {
        "view": "nokker.sessions",
        "contents": "%welcome.sessions%"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:electron": "node scripts/build.mjs && xvfb-run -a node test/electron/run.mjs",
    "package": "node scripts/package.mjs",
    "publish:check": "node scripts/package.mjs --check"
  },
  "devDependencies": {
    "@nokker-apps/brand": "workspace:*",
    "@nokker-apps/cli": "workspace:*",
    "@nokker-apps/mock-server": "workspace:*",
    "@nokker-apps/sdk": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "l10n": "./l10n",
  "galleryBanner": {
    "color": "#1b1b1f",
    "theme": "dark"
  },
  "homepage": "https://github.com/nokker-ai/nokker-apps/tree/main/apps/vscode#readme",
  "bugs": {
    "url": "https://github.com/nokker-ai/nokker-apps/issues"
  }
}
