{
  "appId": "ai.nokker.app",
  "appName": "Nokker",
  "webDir": "../web/dist",
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0b0b0c",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true
    }
  }
}
